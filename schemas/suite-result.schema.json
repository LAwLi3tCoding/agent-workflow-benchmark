{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "suite-result.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "resultType",
    "targetId",
    "suite",
    "runId",
    "gatePolicy",
    "caseResults",
    "dimensionScores",
    "recommendations",
    "p0CaseRecords",
    "contractDiagnostics",
    "rawSuiteScore",
    "cappedSuiteScore",
    "releaseDecision",
    "releaseRuleId",
    "telemetryCompleteness",
    "debugHealth"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "resultType": { "const": "suite" },
    "targetId": { "type": "string" },
    "suite": { "type": "string" },
    "runId": { "type": "string" },
    "gatePolicy": { "$ref": "#/$defs/gatePolicyBinding" },
    "caseResults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caseId", "verdict", "rawScore", "cappedScore", "hardFailures"],
        "properties": {
          "caseId": { "type": "string" },
          "verdict": { "enum": ["PASS", "PASS_WITH_WARNINGS", "FAIL", "DIAGNOSTIC_ONLY"] },
          "rawScore": { "type": "number" },
          "cappedScore": { "type": "number" },
          "hardFailures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "severity", "why", "evidenceEventIds"],
              "properties": {
                "code": {
                  "enum": [
                    "TARGET_ROUTE_FORBIDDEN",
                    "TARGET_OWNER_BYPASS",
                    "GATE_FALSE_PASS",
                    "ARTIFACT_PATH_DRIFT",
                    "TARGET_JOIN_MISSING",
                    "PRODUCTION_SIDE_EFFECT",
                    "PROVENANCE_INVALID",
                    "UNREGISTERED_HARD_FAILURE",
                    "TRACE_EVENT_MISSING",
                    "TRACE_EVENT_ORDER_INVALID",
                    "OBSERVER_EVENT_FORGED",
                    "SECRET_LEAK",
                    "TELEMETRY_MISSING",
                    "TOKEN_LEDGER_MISSING"
                  ]
                },
                "severity": { "enum": ["P0", "P1"] },
                "why": { "type": "string" },
                "evidenceEventIds": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "dimensionScores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimension", "score", "status", "affectedCaseIds", "why"],
        "properties": {
          "dimension": {
            "enum": [
              "contract",
              "routing",
              "ownership",
              "gate",
              "artifact",
              "state",
              "join",
              "sideEffect",
              "telemetry",
              "efficiency",
              "runner"
            ]
          },
          "rawPoints": { "type": "number" },
          "maxPoints": { "type": "number" },
          "score": { "type": "number" },
          "status": { "enum": ["PASS", "WARN", "FAIL", "DIAGNOSTIC_ONLY"] },
          "affectedCaseIds": { "type": "array", "items": { "type": "string" } },
          "why": { "type": "string" }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "priority", "category", "summary", "suggestedChange", "evidenceCaseIds", "sourceFailureCodes"],
        "properties": {
          "id": { "type": "string" },
          "priority": { "enum": ["P0", "P1", "P2"] },
          "category": { "type": "string" },
          "summary": { "type": "string" },
          "suggestedChange": { "type": "string" },
          "evidenceCaseIds": { "type": "array", "items": { "type": "string" } },
          "sourceFailureCodes": { "type": "array", "items": { "type": "string" } },
          "targetRoles": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "p0CaseRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["targetId", "runId", "caseId", "failureCode", "severity", "recommendedAction"],
        "properties": {
          "schemaVersion": { "type": "string" },
          "recordedAt": { "type": "string" },
          "targetId": { "type": "string" },
          "suite": { "type": "string" },
          "runId": { "type": "string" },
          "caseId": { "type": "string" },
          "caseHash": { "type": "string" },
          "contractHash": { "type": "string" },
          "templateId": { "type": "string" },
          "title": { "type": "string" },
          "failureCode": { "type": "string" },
          "severity": { "const": "P0" },
          "why": { "type": "string" },
          "evidenceEventIds": { "type": "array", "items": { "type": "string" } },
          "recommendedAction": { "type": "string" }
        }
      }
    },
    "contractDiagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "statusCodes"],
        "properties": {
          "code": { "const": "CONTRACT_MAPPING_MISSING" },
          "statusCodes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "rawSuiteScore": { "type": "number" },
    "cappedSuiteScore": { "type": "number" },
    "releaseDecision": { "enum": ["APPROVE", "CONDITIONAL_APPROVE", "BLOCK", "DIAGNOSTIC_ONLY"] },
    "releaseRuleId": { "type": "string" },
    "telemetryCompleteness": { "type": "number" },
    "debugHealth": {
      "type": "object",
      "required": [
        "status",
        "mutationKillRate",
        "falseNegativeCount",
        "falsePositiveCount",
        "environmentReproducibility",
        "lastReverseValidationRunId",
        "doesNotAffectTargetScore"
      ],
      "properties": {
        "status": { "enum": ["NOT_RUN", "PASS", "FAIL"] },
        "mutationKillRate": { "type": ["number", "null"] },
        "falseNegativeCount": { "type": ["number", "null"] },
        "falsePositiveCount": { "type": ["number", "null"] },
        "environmentReproducibility": { "type": ["number", "null"] },
        "lastReverseValidationRunId": { "type": ["string", "null"] },
        "doesNotAffectTargetScore": { "const": true }
      }
    },
    "harnessValidation": {
      "type": "object",
      "required": ["schemaVersion", "status", "plan", "phases"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "status": { "enum": ["PASS", "WARN", "FAIL"] },
        "plan": {
          "type": "object",
          "required": [
            "status",
            "recommendedCaseCount",
            "coverageTargetCount",
            "coveredCoverageTargetCount",
            "missingCoverageTargetCount",
            "unknownCoverageTagCount",
            "invalidBindingCount",
            "warnings"
          ],
          "properties": {
            "status": { "enum": ["PASS", "WARN", "FAIL"] },
            "recommendedCaseCount": { "type": "number" },
            "coverageTargetCount": { "type": "number" },
            "coveredCoverageTargetCount": { "type": "number" },
            "missingCoverageTargetCount": { "type": "number" },
            "unknownCoverageTagCount": { "type": "number" },
            "invalidBindingCount": { "type": "number" },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["phase", "status", "why"],
            "properties": {
              "phase": { "type": "string" },
              "status": { "enum": ["PASS", "WARN", "FAIL"] },
              "why": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "gatePolicyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "policyVersion", "policyHash", "rulesHash"],
      "properties": {
        "policyId": { "const": "awb-gate-policy" },
        "policyVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "policyHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "rulesHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
