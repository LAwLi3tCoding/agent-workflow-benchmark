{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comparison-result.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "product",
    "baseline",
    "candidate",
    "comparability",
    "classification",
    "scoreDelta",
    "caseDeltas",
    "summary",
    "hardFailures",
    "evidenceRefs",
    "integrity"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "product": { "const": "Agent Workflow Bench" },
    "baseline": { "$ref": "#/$defs/runSummary" },
    "candidate": { "$ref": "#/$defs/runSummary" },
    "comparability": {
      "type": "object",
      "required": ["status", "reasons"],
      "properties": {
        "status": { "enum": ["COMPARABLE", "INCOMPARABLE"] },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "PROVENANCE_MISSING",
              "PROVENANCE_INVALID",
              "TARGET_ID_MISMATCH",
              "CONTRACT_MISMATCH",
              "SUITE_MISMATCH",
              "CASE_SET_MISMATCH",
              "RUNNER_MISMATCH",
              "EXECUTION_MODE_MISMATCH",
              "EVIDENCE_KIND_MISMATCH",
              "OBSERVATION_LEVEL_MISMATCH",
              "ISOLATION_MISMATCH",
              "PERMISSION_MISMATCH",
              "BUDGET_MISMATCH",
              "COMMAND_POLICY_MISMATCH",
              "ENVIRONMENT_MISMATCH",
              "MODEL_MISMATCH",
              "OBSERVER_MISMATCH",
              "SEED_MISMATCH",
              "CONDITIONS_MISMATCH"
            ]
          }
        }
      }
    },
    "classification": { "enum": ["IMPROVED", "REGRESSED", "UNCHANGED", "MIXED", "HARD_FAILURE", "INCOMPARABLE"] },
    "scoreDelta": { "type": ["number", "null"] },
    "caseDeltas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caseId", "classification", "scoreDelta", "newHardFailures", "resolvedHardFailures"],
        "properties": {
          "caseId": { "type": "string" },
          "classification": { "enum": ["IMPROVED", "REGRESSED", "UNCHANGED", "HARD_FAILURE", "INCOMPARABLE"] },
          "baselineVerdict": { "type": "string" },
          "candidateVerdict": { "type": "string" },
          "scoreDelta": { "type": ["number", "null"] },
          "newHardFailures": { "type": "array", "items": { "type": "string" } },
          "resolvedHardFailures": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["improved", "regressed", "unchanged", "hardFailure", "incomparable"],
      "properties": {
        "improved": { "type": "number" },
        "regressed": { "type": "number" },
        "unchanged": { "type": "number" },
        "hardFailure": { "type": "number" },
        "incomparable": { "type": "number" }
      }
    },
    "hardFailures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "source", "why"],
        "properties": {
          "code": {
            "enum": [
              "TARGET_ROUTE_FORBIDDEN",
              "TARGET_OWNER_BYPASS",
              "GATE_FALSE_PASS",
              "ARTIFACT_PATH_DRIFT",
              "TARGET_JOIN_MISSING",
              "PRODUCTION_SIDE_EFFECT",
              "PROVENANCE_INVALID",
              "UNREGISTERED_HARD_FAILURE",
              "TRACE_EVENT_MISSING",
              "TRACE_EVENT_ORDER_INVALID",
              "OBSERVER_EVENT_FORGED",
              "SECRET_LEAK",
              "TELEMETRY_MISSING",
              "TOKEN_LEDGER_MISSING"
            ]
          },
          "severity": { "enum": ["P0", "P1"] },
          "source": { "enum": ["baseline", "candidate", "comparison"] },
          "caseId": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    },
    "evidenceRefs": {
      "type": "object",
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": { "type": "array", "items": { "type": "string" } },
        "candidate": { "type": "array", "items": { "type": "string" } }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["status", "comparisonHash", "baselineRef", "candidateRef", "artifacts"],
      "properties": {
        "status": { "const": "VERIFIED_AT_WRITE" },
        "comparisonHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "baselineRef": { "type": "string" },
        "candidateRef": { "type": "string" },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "sha256"],
            "properties": {
              "ref": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "runSummary": {
      "type": "object",
      "required": [
        "targetId",
        "suite",
        "runId",
        "releaseDecision",
        "score",
        "provenanceStatus",
        "evidenceKind",
        "observationLevel",
        "observerQualificationStatus"
      ],
      "properties": {
        "targetId": { "type": "string" },
        "suite": { "type": "string" },
        "runId": { "type": "string" },
        "releaseDecision": { "enum": ["APPROVE", "CONDITIONAL_APPROVE", "BLOCK", "DIAGNOSTIC_ONLY"] },
        "score": { "type": "number" },
        "provenanceStatus": { "enum": ["VALID", "MISSING", "INVALID"] },
        "evidenceKind": { "enum": ["live", "simulated", "unknown"] },
        "observationLevel": { "enum": ["workflow_trace", "contract_summary", "synthetic_events", "capability_only", "unknown"] },
        "observerQualificationStatus": { "enum": ["missing", "valid", "invalid", "not_applicable"] }
      }
    }
  }
}
