{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regression-scenarios.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "target", "suite", "runner", "scenarios"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "target": { "type": "string", "minLength": 1 },
    "suite": { "type": "string", "minLength": 1 },
    "runner": { "const": "simulated" },
    "scenarios": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "baselineMutation", "candidateMutation", "expectedClassification", "expectedGate"],
        "properties": {
          "id": {
            "enum": ["normal", "improvement", "regression", "hard-failure", "simulated-only"]
          },
          "baselineMutation": {
            "anyOf": [{ "type": "string", "pattern": "^fixtures/mutations/" }, { "type": "null" }]
          },
          "candidateMutation": {
            "anyOf": [{ "type": "string", "pattern": "^fixtures/mutations/" }, { "type": "null" }]
          },
          "expectedClassification": {
            "enum": ["IMPROVED", "REGRESSED", "UNCHANGED", "HARD_FAILURE", "INCOMPARABLE"]
          },
          "expectedGate": {
            "enum": ["PASS", "DIAGNOSTIC_ONLY", "BLOCK"]
          }
        }
      }
    }
  }
}
