{
  "schemaVersion": "0.1.0",
  "artifactType": "artifact_compatibility_matrix",
  "matrixVersion": "1.0.0",
  "semverPolicy": {
    "patch": "backward-compatible fixes only",
    "minor": "additive fields require migration or diagnostic downgrade",
    "major": "breaking and never auto-migrated",
    "zeroMajor": "0.y.z minor changes are treated as breaking"
  },
  "policies": [
    {
      "artifactType": "contract_model",
      "currentVersion": "0.1.0",
      "readableVersions": ["0.1.x"],
      "migrationMode": "identity",
      "requiredTrustFields": ["contractHash", "evidenceRefs"],
      "missingTrustDisposition": "DIAGNOSTIC_ONLY",
      "unsupportedCode": "ARTIFACT_SCHEMA_VERSION_UNSUPPORTED",
      "action": "Regenerate the ContractModel with a compatible AWB version before using it for comparison or gating."
    },
    {
      "artifactType": "profile_evidence",
      "currentVersion": "0.1.0",
      "readableVersions": ["0.1.x"],
      "migrationMode": "add_metadata",
      "inferUnversionedAs": "0.1.0",
      "requiredTrustFields": ["targetId", "root", "scannedFiles"],
      "missingTrustDisposition": "DIAGNOSTIC_ONLY",
      "unsupportedCode": "ARTIFACT_SCHEMA_VERSION_UNSUPPORTED",
      "action": "Regenerate public profile evidence with a compatible AWB version."
    },
    {
      "artifactType": "generation_manifest",
      "currentVersion": "0.1.0",
      "readableVersions": ["0.1.x"],
      "migrationMode": "add_metadata",
      "requiredTrustFields": ["contractHash", "caseIds", "seed"],
      "missingTrustDisposition": "DIAGNOSTIC_ONLY",
      "unsupportedCode": "ARTIFACT_SCHEMA_VERSION_UNSUPPORTED",
      "action": "Rematerialize the case suite with a compatible AWB version."
    },
    {
      "artifactType": "runtime_manifest",
      "currentVersion": "0.1.0",
      "readableVersions": ["0.1.x"],
      "migrationMode": "add_metadata",
      "inferUnversionedAs": "0.1.0",
      "requiredTrustFields": ["attemptId", "runner.capabilitiesHash", "contractHash", "seed"],
      "missingTrustDisposition": "DIAGNOSTIC_ONLY",
      "unsupportedCode": "ARTIFACT_SCHEMA_VERSION_UNSUPPORTED",
      "action": "Rerun the workflow with a compatible AWB version to regenerate execution identity."
    },
    {
      "artifactType": "observer-qualification",
      "currentVersion": "0.1.0",
      "readableVersions": ["0.1.x"],
      "migrationMode": "diagnostic_on_missing_trust",
      "requiredTrustFields": ["subject.contractHash", "subject.caseSetHash", "integrity.contentHash", "attestation.signature", "attestation.authorityFingerprint"],
      "missingTrustDisposition": "DIAGNOSTIC_ONLY",
      "unsupportedCode": "ARTIFACT_SCHEMA_VERSION_UNSUPPORTED",
      "action": "Requalify the Observer with a separate trusted authority; missing attestation cannot be reconstructed."
    },
    {
      "artifactType": "reliability_report",
      "currentVersion": "0.1.0",
      "readableVersions": ["0.1.x"],
      "migrationMode": "diagnostic_on_missing_trust",
