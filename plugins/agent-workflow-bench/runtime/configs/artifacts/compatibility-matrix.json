    {
      "artifactType": "external_validity_report",
      "currentVersion": "0.1.0",
      "readableVersions": ["0.1.x"],
      "migrationMode": "diagnostic_on_missing_trust",
      "requiredTrustFields": ["integrity.contentHash", "bindings.policyHash", "bindings.verifiedEvidenceHash", "gateEligibility"],
