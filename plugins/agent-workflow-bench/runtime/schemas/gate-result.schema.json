{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-result.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "product",
    "decision",
    "ruleId",
    "targetId",
    "suite",
    "comparisonClassification",
    "comparisonIntegrity",
    "gatePolicy",
    "reasons",
    "evidenceRefs"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "product": { "const": "Agent Workflow Bench" },
    "decision": { "enum": ["PASS", "DIAGNOSTIC_ONLY", "BLOCK"] },
    "ruleId": {
      "enum": [
        "GATE-HARD-FAILURE",
        "GATE-COMPARISON-INTEGRITY",
        "GATE-POLICY-INCOMPARABLE",
        "GATE-REGRESSION",
        "GATE-CANDIDATE-BLOCK",
        "GATE-INCOMPARABLE",
        "GATE-EVIDENCE-NOT-WORKFLOW-TRACE",
        "GATE-OBSERVER-UNQUALIFIED",
        "GATE-CANDIDATE-DIAGNOSTIC",
        "GATE-CANDIDATE-BELOW-PASS",
        "GATE-PASS"
      ]
    },
    "targetId": { "type": "string" },
    "suite": { "type": "string" },
    "comparisonClassification": {
      "enum": ["IMPROVED", "REGRESSED", "UNCHANGED", "MIXED", "HARD_FAILURE", "INCOMPARABLE"]
    },
    "comparisonIntegrity": { "enum": ["VALID", "INVALID"] },
    "gatePolicy": { "$ref": "#/$defs/gatePolicyBinding" },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "gatePolicyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "policyVersion", "policyHash", "rulesHash"],
      "properties": {
        "policyId": { "const": "awb-gate-policy" },
        "policyVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "policyHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "rulesHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
