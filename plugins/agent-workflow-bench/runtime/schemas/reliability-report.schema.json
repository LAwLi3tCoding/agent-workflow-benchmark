{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reliability-report.schema.json",
  "title": "Agent Workflow Bench reliability report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resultType",
    "study",
    "policy",
    "conclusion",
    "strongConclusionAllowed",
    "gateEligibility",
    "metrics",
    "quarantinedCases",
    "debugHealth",
    "samples",
    "integrity"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "resultType": { "const": "reliability_report" },
    "study": { "$ref": "#/$defs/study" },
    "policy": { "$ref": "#/$defs/policy" },
    "conclusion": {
      "enum": [
        "RELIABLE",
        "DIAGNOSTIC_REPRODUCIBLE",
        "QUARANTINED",
        "INSUFFICIENT_SAMPLE",
        "INVALID"
      ]
    },
    "strongConclusionAllowed": { "type": "boolean" },
    "gateEligibility": {
      "enum": ["ELIGIBLE", "DIAGNOSTIC_ONLY", "BLOCK"]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleSize",
        "missingRate",
        "telemetryCompleteness",
        "deterministicAgreement",
        "gateConsistency",
        "caseConsistency",
        "pairedDelta",
        "p0FalsePassCount",
        "p0ObservedCount",
        "p0DetectionRate",
        "duplicateEvidenceCount",
        "aa",
        "dimensionVariance",
        "fixedContextDrift"
      ],
      "properties": {
        "sampleSize": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "observed", "missing", "minimum"],
          "properties": {
            "requested": { "type": "integer", "minimum": 0 },
            "observed": { "type": "integer", "minimum": 0 },
            "missing": { "type": "integer", "minimum": 0 },
            "minimum": { "type": "integer", "minimum": 1 }
          }
        },
        "missingRate": { "$ref": "#/$defs/ratio" },
        "telemetryCompleteness": {
          "$ref": "#/$defs/numericMetric"
        },
        "deterministicAgreement": { "$ref": "#/$defs/ratio" },
        "gateConsistency": { "$ref": "#/$defs/ratioMetric" },
        "caseConsistency": { "$ref": "#/$defs/ratioMetric" },
        "pairedDelta": { "$ref": "#/$defs/numericMetric" },
        "p0FalsePassCount": { "type": "integer", "minimum": 0 },
        "p0ObservedCount": { "type": "integer", "minimum": 0 },
        "p0DetectionRate": {
          "anyOf": [
            { "$ref": "#/$defs/ratio" },
            { "type": "null" }
          ]
        },
        "duplicateEvidenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "aa": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicable", "unchangedRate", "passed"],
          "properties": {
            "applicable": { "type": "boolean" },
            "unchangedRate": { "$ref": "#/$defs/ratio" },
            "passed": { "type": "boolean" }
          }
        },
        "dimensionVariance": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension", "meanDelta", "variance"],
            "properties": {
              "dimension": { "type": "string", "minLength": 1 },
              "meanDelta": { "type": "number" },
              "variance": { "type": "number", "minimum": 0 }
            }
          }
        },
        "fixedContextDrift": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contextHash",
              "sampleCount",
              "gateConsistency",
              "status"
            ],
            "properties": {
              "contextHash": { "$ref": "#/$defs/hash" },
              "sampleCount": { "type": "integer", "minimum": 1 },
              "gateConsistency": { "$ref": "#/$defs/ratio" },
              "status": { "enum": ["PASS", "DRIFT"] }
            }
          }
        }
      }
    },
    "quarantinedCases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "consistency", "status"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "consistency": { "$ref": "#/$defs/ratio" },
          "status": { "const": "QUARANTINED" }
        }
      }
    },
    "debugHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "environmentReproducibility",
        "doesNotAffectTargetScore"
      ],
      "properties": {
        "status": { "enum": ["PASS", "FAIL"] },
        "environmentReproducibility": {
          "$ref": "#/$defs/ratio"
        },
        "doesNotAffectTargetScore": { "const": true }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sample" }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "contentHash"],
      "properties": {
        "status": { "const": "VERIFIED_AT_WRITE" },
        "contentHash": { "$ref": "#/$defs/hash" }
      }
    }
  },
  "$defs": {
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": ["studyId", "kind", "seed"],
      "properties": {
        "studyId": { "$ref": "#/$defs/semanticId" },
        "kind": {
          "enum": [
            "deterministic_repeat",
            "live_aa",
            "live_paired"
          ]
        },
        "seed": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministicMinimumSamples",
        "liveMinimumSamples",
        "gateConsistencyMinimum",
        "caseConsistencyMinimum",
        "maximumMissingRate",
        "minimumTelemetryCompleteness",
        "confidenceLevel",
        "bootstrapIterations",
        "defaultSeed"
      ],
      "properties": {
        "deterministicMinimumSamples": {
          "type": "integer",
          "minimum": 1
        },
        "liveMinimumSamples": { "type": "integer", "minimum": 1 },
        "gateConsistencyMinimum": { "$ref": "#/$defs/ratio" },
        "caseConsistencyMinimum": { "$ref": "#/$defs/ratio" },
        "maximumMissingRate": { "$ref": "#/$defs/ratio" },
        "minimumTelemetryCompleteness": {
          "$ref": "#/$defs/ratio"
        },
        "confidenceLevel": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "bootstrapIterations": {
          "type": "integer",
          "minimum": 1
        },
        "defaultSeed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sampleId", "context"],
      "properties": {
        "status": { "enum": ["observed", "missing"] },
        "sampleId": { "$ref": "#/$defs/semanticId" },
        "missingReason": {
          "enum": [
            "RUN_MISSING",
            "RUN_INVALID",
            "INCOMPARABLE",
            "SEED_MISMATCH",
            "CONTEXT_MISMATCH"
          ]
        },
        "evidenceHash": { "$ref": "#/$defs/hash" },
        "attemptFingerprint": { "$ref": "#/$defs/hash" },
        "baselineRunId": { "$ref": "#/$defs/semanticId" },
        "candidateRunId": { "$ref": "#/$defs/semanticId" },
        "context": { "$ref": "#/$defs/sampleContext" },
        "outcome": { "$ref": "#/$defs/sampleOutcome" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "observed" } },
            "required": ["status"]
          },
          "then": {
            "required": [
              "evidenceHash",
              "attemptFingerprint",
              "baselineRunId",
              "candidateRunId",
              "outcome"
            ],
            "not": { "required": ["missingReason"] }
          },
          "else": {
            "required": ["missingReason"],
            "not": {
              "anyOf": [
                { "required": ["evidenceHash"] },
                { "required": ["attemptFingerprint"] },
                { "required": ["baselineRunId"] },
                { "required": ["candidateRunId"] },
                { "required": ["outcome"] }
              ]
            }
          }
        }
      ]
    },
    "sampleContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "suite",
        "contractHash",
        "caseSetHash",
        "conditionsHash",
        "runnerFingerprint",
        "environmentFingerprint",
        "observerVersion",
        "model",
        "permissionMode",
        "budgetHash",
        "seed",
        "executionMode",
        "evidenceKind",
        "observationLevel",
        "observerQualificationStatus"
      ],
      "properties": {
        "targetId": { "type": "string", "minLength": 1 },
        "suite": { "type": "string", "minLength": 1 },
        "contractHash": { "$ref": "#/$defs/hash" },
        "caseSetHash": { "$ref": "#/$defs/hash" },
        "conditionsHash": { "$ref": "#/$defs/hash" },
        "runnerFingerprint": { "$ref": "#/$defs/hash" },
        "environmentFingerprint": { "$ref": "#/$defs/hash" },
        "observerVersion": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "permissionMode": {
          "enum": [
            "read_only_no_approval",
            "runner_default",
            "none",
            "unknown"
          ]
        },
        "budgetHash": { "$ref": "#/$defs/hash" },
        "seed": { "type": "string", "minLength": 1, "maxLength": 256 },
        "executionMode": { "enum": ["simulated", "live", "unknown"] },
        "evidenceKind": { "enum": ["simulated", "live", "unknown"] },
        "observationLevel": {
          "enum": [
            "synthetic_events",
            "workflow_trace",
            "contract_summary",
            "capability_only",
            "unknown"
          ]
        },
        "observerQualificationStatus": {
          "enum": ["not_applicable", "missing", "valid", "invalid"]
        }
      }
    },
    "sampleOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "gateDecision",
        "baselineScore",
        "candidateScore",
        "scoreDelta",
        "telemetryCompleteness",
        "dimensions",
        "cases"
      ],
      "properties": {
        "classification": {
          "enum": [
            "IMPROVED",
            "REGRESSED",
            "UNCHANGED",
            "MIXED",
            "HARD_FAILURE",
            "INCOMPARABLE"
          ]
        },
        "gateDecision": {
          "enum": ["PASS", "BLOCK", "DIAGNOSTIC_ONLY"]
        },
        "baselineScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "candidateScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "scoreDelta": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "telemetryCompleteness": { "$ref": "#/$defs/ratio" },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension", "baseline", "candidate"],
            "properties": {
              "dimension": { "type": "string", "minLength": 1 },
              "baseline": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "candidate": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "caseId",
              "candidateVerdict",
              "candidateHardFailures"
            ],
            "properties": {
              "caseId": { "type": "string", "minLength": 1 },
              "candidateVerdict": {
                "enum": [
                  "PASS",
                  "PASS_WITH_WARNINGS",
                  "FAIL",
                  "DIAGNOSTIC_ONLY"
                ]
              },
              "candidateHardFailures": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["code", "severity"],
                  "properties": {
                    "code": { "type": "string", "minLength": 1 },
                    "severity": { "enum": ["P0", "P1"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "ratioMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointEstimate", "interval"],
      "properties": {
        "pointEstimate": { "$ref": "#/$defs/ratio" },
        "interval": { "$ref": "#/$defs/interval" }
      }
    },
    "numericMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean", "variance", "interval"],
      "properties": {
        "mean": { "type": "number" },
        "variance": { "type": "number", "minimum": 0 },
        "interval": { "$ref": "#/$defs/interval" }
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "confidenceLevel", "lower", "upper"],
      "properties": {
        "kind": { "enum": ["wilson", "bootstrap"] },
        "confidenceLevel": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "lower": { "type": "number" },
        "upper": { "type": "number" }
      }
    },
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "semanticId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
