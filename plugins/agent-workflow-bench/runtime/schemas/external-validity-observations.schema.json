{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external-validity-observations.schema.json",
  "title": "Agent Workflow Bench external validity observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultType", "studyId", "status", "items"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "resultType": { "const": "external_validity_observations" },
    "studyId": { "$ref": "#/$defs/semanticId" },
    "status": { "enum": ["DRAFT", "COMPLETE"] },
    "items": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/observationItem" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "COMPLETE" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "items": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "semanticId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparisonRef", "comparisonHash"],
      "properties": {
        "comparisonRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000]+$"
        },
        "comparisonHash": { "$ref": "#/$defs/hash" }
      }
    },
    "observationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "evidence"],
      "properties": {
        "itemId": { "$ref": "#/$defs/semanticId" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
