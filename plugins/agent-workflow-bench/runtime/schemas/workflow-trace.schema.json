{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-trace.schema.json",
  "type": "object",
  "required": ["schemaVersion", "observer", "subject", "cases", "attestation"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "observer": {
      "type": "object",
      "required": ["id", "version", "keyFingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "keyFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "implementationHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "evidenceCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "filesystem",
              "tool",
              "process",
              "network",
              "artifact",
              "state",
              "side_effect",
              "token"
            ]
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "required": [
        "targetId",
        "contractHash",
        "suite",
        "seed",
        "caseSetHash",
        "runner",
        "isolation",
        "permissionMode"
      ],
      "properties": {
        "targetId": { "type": "string", "minLength": 1 },
        "contractHash": { "type": "string", "minLength": 1 },
        "suite": { "type": "string", "minLength": 1 },
        "seed": { "type": "string", "minLength": 1 },
        "caseSetHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "runner": {
          "type": "object",
          "required": ["name", "adapterVersion", "capabilitiesHash"],
          "properties": {
            "name": { "enum": ["codex", "claude", "opencode"] },
            "adapterVersion": { "type": "string", "minLength": 1 },
            "version": { "type": "string" },
            "capabilitiesHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "isolation": { "enum": ["read_only_sandbox", "working_directory_only"] },
        "permissionMode": { "enum": ["read_only_no_approval", "runner_default"] },
        "isolationManifest": { "$ref": "#/$defs/isolationManifest" },
        "model": { "type": "string" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "templateId",
          "runId",
          "events",
          "wallClockSeconds",
          "tokens",
          "telemetryCompleteness"
        ],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "templateId": { "type": "string", "minLength": 1 },
          "runId": { "type": "string", "minLength": 1 },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["eventId", "timestamp", "type", "actor", "payload"],
              "properties": {
                "eventId": { "type": "string", "minLength": 1 },
                "timestamp": { "type": "string" },
                "type": {
                  "enum": [
                    "case_start",
                    "contract_observed",
                    "handoff",
                    "gate_decision",
                    "artifact_write",
                    "state_read",
                    "side_effect_attempt",
                    "token_usage",
                    "runner_start",
                    "runner_transcript",
                    "runner_result",
                    "runner_exit",
                    "filesystem_access",
                    "tool_call",
                    "process_spawn",
                    "network_access",
                    "hard_failure",
                    "case_end"
                  ]
                },
                "actor": { "type": "string", "minLength": 1 },
                "payload": { "type": "object" }
              }
            }
          },
          "wallClockSeconds": { "type": "number", "minimum": 0 },
          "tokens": {
            "type": "object",
            "required": ["input", "output", "total", "wasted", "costEstimateConfidence"],
            "properties": {
              "input": { "type": "number", "minimum": 0 },
              "output": { "type": "number", "minimum": 0 },
              "total": { "type": "number", "minimum": 0 },
              "wasted": { "type": "number", "minimum": 0 },
              "costEstimateConfidence": { "enum": ["high", "medium", "low", "unavailable"] }
            }
          },
          "telemetryCompleteness": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "attestation": {
      "type": "object",
      "required": ["algorithm", "signature"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "signature": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "isolationManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "platform",
        "runtimeVersion",
        "policyHash",
        "mountManifestHash",
        "networkMode",
        "processPolicy",
        "capabilities",
        "noNewPrivileges",
        "readOnlyRootfs",
        "writableMounts",
        "canaries",
        "manifestHash"
      ],
      "properties": {
        "backend": { "enum": ["macos-seatbelt", "linux-oci-docker"] },
        "platform": { "type": "string", "minLength": 1 },
        "runtimeVersion": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "imageId": { "$ref": "#/$defs/hash" },
        "policyHash": { "$ref": "#/$defs/hash" },
        "mountManifestHash": { "$ref": "#/$defs/hash" },
        "networkMode": { "const": "none" },
        "processPolicy": {
          "enum": [
            "seatbelt_process_exec_allowlist",
            "seccomp_launcher_no_child_process"
          ]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["drop", "add"],
          "properties": {
            "drop": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": { "const": "ALL" }
            },
            "add": {
              "type": "array",
              "maxItems": 0,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "noNewPrivileges": { "const": true },
        "readOnlyRootfs": { "type": "boolean" },
        "writableMounts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "canaries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "signingKeyRead",
            "networkDenied",
            "nestedProcessDenied",
            "outOfScopeWriteDenied"
          ],
          "properties": {
            "signingKeyRead": {
              "enum": ["EPERM", "ABSENT_FROM_MOUNT_NAMESPACE"]
            },
            "networkDenied": {
              "enum": ["EPERM", "NETWORK_UNREACHABLE"]
            },
            "nestedProcessDenied": {
              "enum": ["EPERM", "DENIED"]
            },
            "outOfScopeWriteDenied": {
              "enum": ["EPERM", "EROFS", "EACCES"]
            }
          }
        },
        "manifestHash": { "$ref": "#/$defs/hash" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "backend": { "const": "linux-oci-docker" } }
          },
          "then": {
            "required": ["image", "imageId"],
            "properties": {
              "platform": { "const": "linux" },
              "processPolicy": {
                "const": "seccomp_launcher_no_child_process"
              },
              "readOnlyRootfs": { "const": true },
              "writableMounts": { "const": ["/tmp", "/workspace"] }
            }
          }
        },
        {
          "if": {
            "properties": { "backend": { "const": "macos-seatbelt" } }
          },
          "then": {
            "properties": {
              "platform": { "const": "darwin" },
              "processPolicy": {
                "const": "seatbelt_process_exec_allowlist"
              }
            }
          }
        }
      ]
    }
  }
}
