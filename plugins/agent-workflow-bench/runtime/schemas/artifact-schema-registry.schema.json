{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact-schema-registry.schema.json",
  "title": "Agent Workflow Bench artifact schema registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "registryVersion",
    "schemaFiles",
    "entries"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "artifactType": { "const": "artifact_schema_registry" },
    "registryVersion": { "$ref": "#/$defs/semver" },
    "schemaFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*\\.schema\\.json$"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "artifactType": {
      "enum": [
        "contract_model",
        "profile_evidence",
        "generation_manifest",
        "runtime_manifest",
        "observer-qualification",
        "reliability_report",
        "external_validity_report",
        "suite",
        "comparison_result",
        "gate_result",
        "provenance"
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "fileNames",
        "schemaFile",
        "currentVersion",
        "compatibilityPolicyRef",
        "migrationSupported"
      ],
      "properties": {
        "artifactType": { "$ref": "#/$defs/artifactType" },
        "fileNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "schemaFile": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*\\.schema\\.json$"
        },
        "currentVersion": { "$ref": "#/$defs/semver" },
        "compatibilityPolicyRef": {
          "type": "string",
          "pattern": "^compatibility-matrix\\.json#[A-Za-z0-9_-]+$"
        },
        "migrationSupported": { "type": "boolean" }
      }
    }
  }
}
