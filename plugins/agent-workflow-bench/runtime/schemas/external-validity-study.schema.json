{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external-validity-study.schema.json",
  "title": "Agent Workflow Bench external validity study",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resultType",
    "studyId",
    "protocolVersion",
    "blinding",
    "targets",
    "items"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "resultType": { "const": "external_validity_study" },
    "studyId": { "$ref": "#/$defs/semanticId" },
    "protocolVersion": { "const": "criterion-validity-v1" },
    "blinding": { "$ref": "#/$defs/blinding" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/target" }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/studyItem" }
    }
  },
  "$defs": {
    "semanticId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "publicExternalRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!(?:.*(?:/\u0055sers/|/\u0068ome/|/private/|@|private-target|company-domain)))(?:external|https|ipfs)://[^\\u0000]+$"
    },
    "targetClass": {
      "enum": ["directory", "cli", "hybrid"]
    },
    "runner": {
      "enum": ["codex", "claude"]
    },
    "designStratum": {
      "enum": [
        "known_improvement",
        "no_change",
        "ordinary_regression",
        "p0_regression"
      ]
    },
    "blinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "assignmentHash"],
      "properties": {
        "mode": { "const": "double_blind" },
        "assignmentHash": { "$ref": "#/$defs/hash" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "blindedTargetId",
        "targetClass",
        "targetRefHash",
        "contractHash",
        "contractReview"
      ],
      "properties": {
        "targetId": { "$ref": "#/$defs/semanticId" },
        "blindedTargetId": { "$ref": "#/$defs/semanticId" },
        "targetClass": { "$ref": "#/$defs/targetClass" },
        "targetRefHash": { "$ref": "#/$defs/hash" },
        "contractHash": { "$ref": "#/$defs/hash" },
        "contractReview": { "$ref": "#/$defs/contractReview" }
      }
    },
    "contractReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["reviewed", "pending_human_input"]
        },
        "artifactHash": { "$ref": "#/$defs/hash" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "reviewed" } },
            "required": ["status"]
          },
          "then": { "required": ["artifactHash"] }
        }
      ]
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "contentHash"],
      "properties": {
        "ref": { "$ref": "#/$defs/publicExternalRef" },
        "contentHash": { "$ref": "#/$defs/hash" }
      }
    },
    "studyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "blindedChangeId",
        "targetId",
        "runner",
        "runnerBlindId",
        "designStratum",
        "baseline",
        "candidate"
      ],
      "properties": {
        "itemId": { "$ref": "#/$defs/semanticId" },
        "blindedChangeId": { "$ref": "#/$defs/semanticId" },
        "targetId": { "$ref": "#/$defs/semanticId" },
        "runner": { "$ref": "#/$defs/runner" },
        "runnerBlindId": { "$ref": "#/$defs/semanticId" },
        "designStratum": { "$ref": "#/$defs/designStratum" },
        "baseline": { "$ref": "#/$defs/artifactRef" },
        "candidate": { "$ref": "#/$defs/artifactRef" }
      }
    }
  }
}
